# 必填：MySQL JDBC 地址，留空等待本机填写。
DB_URL=
# 必填：MySQL 用户名，不填写真实值到示例文件。
DB_USERNAME=
# 必填：MySQL 密码，不填写真实值到示例文件。
DB_PASSWORD=
# 必填：首次初始化管理员的用户名。
HOOKFLOW_ADMIN_USERNAME=
# 必填：首次初始化管理员的密码。
HOOKFLOW_ADMIN_PASSWORD=
# 必填：用于加密接收端签名密钥的应用主密钥。
HOOKFLOW_SECRET_ENCRYPTION_KEY=
# 可选：Redis 仅用于加速唤醒，不是任务事实来源。
# REDIS_HOST=localhost
# 可选：Redis 端口示例。
# REDIS_PORT=6379
# 可选：每轮最多尝试 1～3 次，默认 3 次。
# HOOKFLOW_MAX_ATTEMPTS=3
# 可选：两档正数重试间隔，默认 10 秒、30 秒。
# HOOKFLOW_RETRY_DELAYS=10s,30s